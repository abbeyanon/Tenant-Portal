{
  "name": "Rent Payment",
  "doctype": "DocType",
  "module": "Tenant Portal",
  "autoname": "format:REC-{YYYY}-{####}",
  "fields": [
    {
      "fieldname": "receipt_number",
      "fieldtype": "Data",
      "label": "Receipt Number",
      "reqd": 1
    },
    {
      "fieldname": "tenant_name",
      "fieldtype": "Data",
      "label": "Tenant Name",
      "reqd": 1
    },
    {
      "fieldname": "unit_number",
      "fieldtype": "Link",
      "label": "Unit Number",
      "options": "Property Unit",
      "reqd": 1
    },
    {
      "fieldname": "amount",
      "fieldtype": "Currency",
      "label": "Amount Paid (KES)",
      "reqd": 1
    },
    {
      "fieldname": "payment_type",
      "fieldtype": "Select",
      "label": "Payment Type",
      "options": "Rent\nWater\nElectricity\nService Charge\nDeposit",
      "default": "Rent"
    },
    {
      "fieldname": "payment_method",
      "fieldtype": "Select",
      "label": "Payment Method",
      "options": "M-Pesa\nCard\nBank Transfer",
      "default": "M-Pesa"
    },
    {
      "fieldname": "transaction_reference",
      "fieldtype": "Data",
      "label": "Transaction Reference"
    },
    {
      "fieldname": "invoice_month",
      "fieldtype": "Data",
      "label": "Invoice Month"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Completed\nPending\nFailed",
      "default": "Completed"
    },
    {
      "fieldname": "posting_date",
      "fieldtype": "Datetime",
      "label": "Posting Date"
    }
  ]
}
